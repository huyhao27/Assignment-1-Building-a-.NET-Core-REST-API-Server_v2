@host = http://localhost:5141

### Login as admin
# @name adminLogin
POST {{host}}/api/Auth/login
Content-Type: application/json

{ "username": "admin", "password": "admin123" }

### Admin: list inventory
GET {{host}}/api/Inventory
Authorization: Bearer {{adminLogin.response.body.$.token}}

### Admin: create item
POST {{host}}/api/Inventory
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "itemId": "shield_001", "name": "Wooden Shield", "quantity": 2, "playerId": "player1" }

### Admin: partially update the first item (copy an id from the list above)
PATCH {{host}}/api/Inventory/REPLACE_WITH_ITEM_ID
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "quantity": 7 }

### Validation error (expect 400)
POST {{host}}/api/Inventory
Authorization: Bearer {{adminLogin.response.body.$.token}}
Content-Type: application/json

{ "itemId": "", "name": "", "quantity": -5, "playerId": "" }

### Login as player1
# @name playerLogin
POST {{host}}/api/Auth/login
Content-Type: application/json

{ "username": "player1", "password": "player123" }

### Player: get own profile
GET {{host}}/api/PlayerProfile
Authorization: Bearer {{playerLogin.response.body.$.token}}

### Player: inventory is admin-only (expect 403)
GET {{host}}/api/Inventory
Authorization: Bearer {{playerLogin.response.body.$.token}}
